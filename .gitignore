# Compiler files
cache/
out/

# Deployment records. Real broadcasts are tracked -- they are the authoritative
# record of what was deployed, and forge verify-contract reads them. Local anvil
# runs and simulations are not. Forge writes anything sensitive to cache/, which
# is ignored above.
/broadcast/*/31337/
/broadcast/**/dry-run/

# Dotenv file
.env

.idea
.DS_Store
